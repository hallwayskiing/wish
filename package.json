{
  "name": "wish-realizer",
  "version": "1.0.0",
  "description": "A cosmic wishing well powered by Gemini and deployed by Cloudflare.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check": "find src -name '*.js' -exec node --check {} + && node --check vite.config.js"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
