{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wish-realizer",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-25",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.yaml"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wish-realizer-db",
      "database_id": "c0801e0a-36ef-428e-9f8a-f43b48bdc6fd"
    }
  ],
  "observability": {
    "enabled": true
  }
}
